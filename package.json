    "pruef:browser:ventil": "node figur/tests/tools/pruefe-figur.mjs http://127.0.0.1:8311/Wegeventil-5-2/ Wegeventil-5-2/tests/tools/pruefe-ventil.mjs",
    "pruef:browser:ventil32": "node figur/tests/tools/pruefe-figur.mjs http://127.0.0.1:8311/Wegeventil-3-2/ Wegeventil-3-2/tests/tools/pruefe-ventil-3-2.mjs",
