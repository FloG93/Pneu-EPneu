    "pruef:browser:zylinder-ew": "node figur/tests/tools/pruefe-figur.mjs http://127.0.0.1:8311/Zylinder-Einfachwirkend/ Zylinder-Einfachwirkend/tests/tools/pruefe-zylinder-ew.mjs",
    "bau:zylinder": "node Zylinder-Doppeltwirkend/tests/tools/build-zylinder.mjs",
