{
  "name": "pneu-epneu",
  "private": true,
  "type": "module",
  "description": "Pneumatik und E-Pneumatik: erklärte Bauteile als interaktive isometrische Figuren für Auszubildende",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "test": "npm run test:shared && npm run test:figur && npm run test:zylinder",
    "test:shared": "node --test \"shared/tests/*.test.mjs\"",
    "test:figur": "node --test \"figur/tests/*.test.mjs\"",
    "test:zylinder": "node --test \"Zylinder-Doppeltwirkend/tests/*.test.mjs\"",
    "bau:zylinder": "node Zylinder-Doppeltwirkend/tests/tools/build-zylinder.mjs",
    "pruef:zylinder": "node Zylinder-Doppeltwirkend/tests/tools/build-zylinder.mjs --audit && node Zylinder-Doppeltwirkend/tests/tools/build-zylinder.mjs --apart",
    "bau:uebersicht": "node figur/tests/tools/build-uebersicht.mjs",
    "pruef:browser": "node figur/tests/tools/pruefe-figur.mjs http://127.0.0.1:8311/Zylinder-Doppeltwirkend/",
    "pruef:linien": "node .claude/skills/anatomy/scripts/lines.mjs Zylinder-Doppeltwirkend/index.html"
  },
  "engines": {
    "node": ">=22"
  }
}
