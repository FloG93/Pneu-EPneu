    "bau:ventil32": "node Wegeventil-3-2/tests/tools/build-ventil-3-2.mjs",
    "pruef:ventil32": "node Wegeventil-3-2/tests/tools/build-ventil-3-2.mjs --audit && node Wegeventil-3-2/tests/tools/build-ventil-3-2.mjs --apart",
    "bau:drossel": "node Drosselrueckschlagventil/tests/tools/build-drossel.mjs",
